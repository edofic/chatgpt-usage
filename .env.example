# Codex must be available to the mini-cloud service, not just your login shell.
# Set an absolute executable path if it is missing from the service's PATH.
CODEX_BIN=codex

# Optional: store history outside the default data/usage.sqlite.
# DATABASE_PATH=/absolute/path/to/usage.sqlite

# Optional: path to an existing Antigravity OAuth token file
# (either legacy acp_token.json or agy's antigravity-oauth-token).
# When unset, only Codex limits are collected.
# ANTIGRAVITY_TOKEN_PATH=/absolute/path/to/acp_token.json

# Optional: agy CLI executable used to refresh expired antigravity-oauth-token files.
# AGY_BIN=agy

